# Anthropic API Key (필수)
ANTHROPIC_API_KEY=sk-ant-여기에_키_입력

# GitHub (선택 - GitHub 기능 사용 시)
GITHUB_TOKEN=ghp_여기에_토큰_입력
GITHUB_USERNAME=여기에_유저명_입력

# Email (선택 - 이메일 답장 기능 사용 시)
# Gmail의 경우 앱 비밀번호 사용: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=your@gmail.com
EMAIL_PASSWORD=앱_비밀번호_입력
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
